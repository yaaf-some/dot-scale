// Cloudflare Worker + static assets for Dot Scale. No build step: wrangler bundles worker/index.js itself and
// uploads the repo root as static assets (everything private is excluded by .assetsignore).
{
  "name": "dot-scale",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",

  // Serve the app from the repo root; only /api/* runs the Worker first (static files never invoke it).
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Household sync database (D1). The id is a resource id, not a secret. The Worker still refuses to run sync until the
  // SYNC_PEPPER secret exists and the tables are created (docs/DEPLOY.md, "Household sync").
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dot-scale",
      "database_id": "24094e4a-656a-433d-860c-241d7723b750",
      "migrations_dir": "migrations"
    }
  ],

  // Gives the site a *.workers.dev address for testing before the custom domain is switched over.
  "workers_dev": true,

  // Workers Builds builds every non-production branch with `wrangler preview`, which refuses to run without this block.
  // An empty block is enough; production deploys (`wrangler deploy` on main) ignore it.
  "previews": {}

  // Custom domain: coffee.yaafsome.fyi is attached in the dashboard (docs/DEPLOY.md, step 1).
  // To pin it in this file instead, add (only while no other DNS record uses that name, or the deploy fails):
  //   "routes": [{ "pattern": "coffee.yaafsome.fyi", "custom_domain": true }]
}
